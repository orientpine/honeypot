{
  "name": "honeypot",
  "owner": {
    "name": "Baekdong Cha",
    "url": "https://github.com/orientpine"
  },
  "metadata": {
    "version": "3.10.0",
    "description": "ISD 연구계획서 생성, 시각자료 프롬프트, DC연금 포트폴리오 분석을 위한 Claude Code 플러그인 마켓플레이스"
  },
  "plugins": [
    {
      "name": "isd-generator",
      "source": "./plugins/isd-generator",
      "description": "ISD 연구계획서 전체 생성 (오케스트레이터 + 5개 Chapter + 이미지)",
      "version": "1.0.1",
      "strict": true,
      "agents": [
        "./agents/chapter1.md",
        "./agents/chapter2.md",
        "./agents/chapter3.md",
        "./agents/chapter4.md",
        "./agents/chapter5.md",
        "./agents/figure.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "visual-generator",
      "source": "./plugins/visual-generator",
      "description": "시각자료 프롬프트 생성 및 이미지 렌더링 (4-block v3.0.0, Kurzgesagt/Gov/Seminar/WhatIf/Pitch/Comparison + Renderer)",
      "version": "3.3.0",
      "strict": true,
      "agents": [
        "./agents/content-organizer.md",
        "./agents/content-reviewer.md",
        "./agents/prompt-designer.md",
        "./agents/renderer-agent.md",
        "./agents/prompt-validator.md"
      ],
      "skills": [
        "./skills/layout-types",
        "./skills/theme-concept",
        "./skills/theme-gov",
        "./skills/theme-seminar",
        "./skills/theme-whatif",
        "./skills/theme-pitch",
        "./skills/theme-comparison",
        "./skills/slide-renderer"
      ]
    },
    {
      "name": "investments-portfolio",
      "source": "./plugins/investments-portfolio",
      "description": "DC 연금 포트폴리오 분석 멀티 에이전트 시스템. web-search-verifier 스킬로 환각 방지.",
      "version": "1.0.1",
      "strict": true,
      "agents": [
        "./agents/fund-portfolio.md",
        "./agents/compliance-checker.md",
        "./agents/output-critic.md",
        "./agents/material-organizer.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "macro-analysis",
      "source": "./plugins/macro-analysis",
      "description": "거시경제 분석 공용 에이전트 모음. 지수/금리/섹터/리스크/리더십 분석 및 종합/검증을 제공합니다.",
      "strict": true,
      "agents": [
        "./agents/index-fetcher.md",
        "./agents/rate-analyst.md",
        "./agents/sector-analyst.md",
        "./agents/risk-analyst.md",
        "./agents/leadership-analyst.md",
        "./agents/macro-synthesizer.md",
        "./agents/macro-critic.md"
      ]
    },
    {
      "name": "general-agents",
      "source": "./plugins/general-agents",
      "description": "범용 에이전트 모음",
      "strict": true,
      "agents": ["./agents/interview.md"]
    },
    {
      "name": "paper-style-generator",
      "source": "./plugins/paper-style-generator",
      "description": "PDF 논문 분석을 통한 논문 작성 스타일 스킬 자동 생성 메타-플러그인. MinerU로 PDF 변환 후 스타일 패턴을 추출하여 섹션별 독립 스킬 세트를 생성합니다.",
      "version": "1.4.0",
      "strict": true,
      "agents": [
        "./agents/pdf-converter.md",
        "./agents/style-analyzer.md",
        "./agents/skill-generator.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "report-generator",
      "source": "./plugins/report-generator",
      "description": "연구 노트를 분석하여 공학 박사 수준의 국가기관 제출용 연구 보고서를 자동 생성하는 플러그인.",
      "strict": true,
      "agents": [
        "./agents/input-analyzer.md",
        "./agents/content-mapper.md",
        "./agents/chapter-writer.md",
        "./agents/quality-checker.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "stock-consultation",
      "source": "./plugins/stock-consultation",
      "description": "주식/ETF 투자 상담 Multi-Agent 시스템. Bogle/Vanguard 철학 기반.",
      "strict": true,
      "agents": [
        "./agents/materials-organizer.md",
        "./agents/stock-screener.md",
        "./agents/stock-valuation.md",
        "./agents/bear-case-critic.md",
        "./agents/stock-critic.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "equity-research",
      "source": "./plugins/equity-research",
      "description": "Professional equity research analysis with institutional-grade formatting.",
      "strict": true,
      "agents": ["./agents/equity-research-analyst.md"]
    },
    {
      "name": "hwpx-generator",
      "source": "./plugins/hwpx-generator",
      "description": "HWPX 문서 생성/편집/분석 통합 플러그인. XML-first 빌드 + ZIP 치환 + ZIP-level surgery 지원. Workflow 7: 마크다운 → HWPX 템플릿 채우기 + 이미지 임베딩.",
      "version": "3.0.0",
      "strict": true,
      "agents": [
        "./agents/hwpx-builder.md",
        "./agents/hwpx-analyzer.md"
      ],
      "skills": ["./skills"]
    },
    {
      "name": "worktree-workflow",
      "source": "./plugins/worktree-workflow",
      "description": "Git worktree를 활용한 Claude Code 병렬 실행 워크플로우",
      "strict": true,
      "agents": ["./agents/worktree.md"]
    },
    {
      "name": "plugin-dev",
      "source": "./plugins/plugin-dev",
      "description": "Claude Code 플러그인 개발 종합 툴킷. Hook, MCP, 플러그인 구조, 설정, 커맨드/에이전트/스킬 개발 가이드 제공.",
      "version": "0.1.0",
      "strict": true,
      "agents": [
        "./agents/agent-creator.md",
        "./agents/plugin-validator.md",
        "./agents/skill-reviewer.md"
      ],
      "skills": ["./skills"],
      "homepage": "https://github.com/anthropics/claude-code/tree/main/plugins/plugin-dev"
    },
    {
      "name": "patent-trend-analyzer",
      "source": "./plugins/patent-trend-analyzer",
      "description": "KIPRIS API 기반 특허 동향 분석 - 키워드 클러스터링, 검색 최적화, 다축 분류, 시각화 대시보드 생성",
      "version": "1.3.0",
      "strict": true,
      "agents": [
        "./agents/patent-planner.md",
        "./agents/patent-searcher.md",
        "./agents/patent-analyzer.md"
      ],
      "skills": ["./skills"],
      "license": "MIT",
      "author": {
        "name": "Baekdong Cha",
        "email": "orientpine@gmail.com"
      },
      "contributors": [
        {
          "name": "Gunju Park",
          "email": "uio88890@gmail.com"
        }
      ]
    },
    {
      "name": "pptx-design-styles",
      "source": "./plugins/pptx-design-styles",
      "description": "30가지 모던 PPTX 디자인 스타일 가이드. HEX 색상, 폰트, 레이아웃, 시그니처 요소 포함. 원본: corazzon/pptx-design-styles",
      "version": "1.0.0",
      "strict": true,
      "skills": ["./skills"]
    },
    {
      "name": "obsidian-skills",
      "source": "./plugins/obsidian-skills",
      "description": "Obsidian vault 파일 작성/편집을 위한 Agent Skills. Markdown(wikilinks, embeds, callouts), Bases(.base), JSON Canvas(.canvas), CLI, Defuddle 지원. 원본: kepano/obsidian-skills",
      "version": "1.0.0",
      "strict": true,
      "skills": ["./skills"]
    }
  ]
}
